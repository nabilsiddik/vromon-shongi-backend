# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/vromon_shongi?schema=public

# Security & JWT
SALT_ROUND=10
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payments & Subscriptions
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
